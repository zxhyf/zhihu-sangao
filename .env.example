# 复制为 .env 后填入你自己的 Key；不填也能运行（自动降级为本地规则引擎）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口（被占用时会自动向后寻找可用端口）
APP_HOST=127.0.0.1
APP_PORT=8600

# ---------------- 运行模式 ----------------
# demo=本地演示（默认）/ prod=正式试用（不自动写入演示数据）
APP_ENV=demo

# 评委体验模式：每个会话独立演示数据、隐藏管理入口、管理接口 403
JUDGE_MODE=1

# 一律使用本地规则引擎（1）。评委体验最稳：不依赖网络、不烧 token。
# 录演示视频想用大模型时设为 0。
PREFER_LOCAL=1

# 演示用户多少小时无活动后自动清理
DEMO_USER_TTL_HOURS=48

# 会话有效期（小时），评委模式默认 48
SESSION_TTL_HOURS=48

# 每个会话每小时最多发多少条消息（0 = 不限）
RATE_LIMIT_PER_HOUR=120

# ---------------- 管理接口 ----------------
# 1=开放知识库上传/清空等管理接口；评委模式下会被强制关闭
ENABLE_ADMIN_API=0

# 反过来，你自己维护知识库时：JUDGE_MODE=0 + ENABLE_ADMIN_API=1
# 需要把地址发给别人时再加访问密码，未设密码只监听本机：
# APP_PASSWORD=换成你自己的密码

# 单条消息最大长度（字）
MAX_MESSAGE_LEN=2000
