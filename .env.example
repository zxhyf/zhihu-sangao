# 复制为 .env 后填入你自己的 Key；不填也能运行（自动降级为本地规则引擎）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口（被占用时会自动向后寻找可用端口）
APP_HOST=127.0.0.1
APP_PORT=8600

# ---------------- 安全与运行模式 ----------------
# demo=本地演示（默认）/ prod=正式试用（不自动写入演示数据）
APP_ENV=demo

# 设置后即开启「共享演示模式」：打开页面先登录，所有 /api 需会话
# 把地址发给评委、或部署到局域网/云主机时，必须设置
# APP_PASSWORD=换成你自己的密码

# 未设密码时，服务只监听 127.0.0.1；传 --host 0.0.0.0 会被强制回退并提示

# 单条消息最大长度（字）
MAX_MESSAGE_LEN=2000
